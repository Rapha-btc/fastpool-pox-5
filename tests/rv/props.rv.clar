;; ============================================================================
;; RENDEZVOUS property suite `rv-props` (test-only contract).
;;
;; Each private test-* function drives the production wiring end to end:
;; mock pox-5 rewards -> signer claim -> fund-swap-vault -> the vault's sale
;; paths against the adversarial mock router -> finalize -> distribute, and
;; asserts exact outcomes against independently restated formulas.
;;
;; Why a separate contract: an err from a contract-call? rolls that call
;; back, an err from an intra-contract call does not, so tests that expect a
;; refusal must reach the vault/signer through contract-call?. This contract
;; is seeded as a signer admin by build.py and makes admin calls inside
;; as-contract? (contract-caller == tx-sender == rv-props).
;;
;; A test whose precondition does not hold (the vault is mid-batch with the
;; window still open) returns (ok false): RV counts it as discarded.
;; ============================================================================

(define-constant SIGNER .signer-manager-vault-stx-rewards)
(define-constant VAULT .fastpool-swap-vault)
(define-constant BPS u10000)
(define-constant FO_DIV u10000000000)
(define-constant ERR_ASSERT (err u9999))
(define-data-var next-cycle uint u100)

(define-private (fo (amount uint) (limit uint)) (/ (* amount limit) FO_DIV))
(define-private (under (mid uint) (bps uint)) (/ (* mid (- BPS bps)) BPS))
(define-private (min2 (a uint) (b uint)) (if (< a b) a b))
(define-private (sbtc (who principal)) (unwrap-panic (contract-call? .mock-ft get-balance who)))
(define-private (lazer-mid) (contract-call? .mock-lazer-oracle get-mid))
(define-private (clock) (contract-call? .fastpool-swap-vault get-clock))
(define-private (check (b bool) (code uint)) (if b (ok true) (err code)))

;; --- admin calls through the signer ------------------------------------------
(define-private (adm-window (b uint))
  (as-contract? ((with-all-assets-unsafe))
    (try! (contract-call? .signer-manager-vault-stx-rewards set-vault-window-blocks b .fastpool-swap-vault))))
(define-private (adm-slip (b uint))
  (as-contract? ((with-all-assets-unsafe))
    (try! (contract-call? .signer-manager-vault-stx-rewards set-vault-slippage-bps b .fastpool-swap-vault))))
(define-private (adm-noslip (b uint))
  (as-contract? ((with-all-assets-unsafe))
    (try! (contract-call? .signer-manager-vault-stx-rewards set-vault-no-pyth-slippage-bps b .fastpool-swap-vault))))
(define-private (adm-cooldown (b uint))
  (as-contract? ((with-all-assets-unsafe))
    (try! (contract-call? .signer-manager-vault-stx-rewards set-vault-router-cooldown b .fastpool-swap-vault))))
(define-private (adm-chunk (b uint))
  (as-contract? ((with-all-assets-unsafe))
    (try! (contract-call? .signer-manager-vault-stx-rewards set-vault-max-chunk-sats b .fastpool-swap-vault))))
(define-private (adm-budget (b uint))
  (as-contract? ((with-all-assets-unsafe))
    (try! (contract-call? .signer-manager-vault-stx-rewards set-vault-pyth-fee-budget b .fastpool-swap-vault))))
(define-private (adm-fees (b uint))
  (as-contract? ((with-all-assets-unsafe))
    (try! (contract-call? .signer-manager-vault-stx-rewards update-fees b))))
(define-private (adm-split (a uint) (j uint) (d uint) (x uint) (v uint))
  (as-contract? ((with-all-assets-unsafe))
    (try! (contract-call? .signer-manager-vault-stx-rewards router-swap-split a j d x v 0x .fastpool-swap-vault))))
(define-private (adm-dia (a uint) (d uint) (x uint) (v uint))
  (as-contract? ((with-all-assets-unsafe))
    (try! (contract-call? .signer-manager-vault-stx-rewards router-swap-split-dia a d x v .fastpool-swap-vault))))
(define-private (adm-take (a uint))
  (as-contract? ((with-all-assets-unsafe))
    (try! (contract-call? .signer-manager-vault-stx-rewards jing-take a 0x .fastpool-swap-vault))))
(define-private (adm-withdraw (a uint))
  (as-contract? ((with-all-assets-unsafe))
    (try! (contract-call? .signer-manager-vault-stx-rewards withdraw-fees a 'ST2CY5V39NHDPWSXMW9QDT3HC3GD6Q6XX4CFRK9AG))))

;; --- world --------------------------------------------------------------------
(define-private (calm-world)
  (begin
    (unwrap-panic (contract-call? .mock-dia set-stale false))
    (unwrap-panic (contract-call? .mock-dia set-failed false))
    (unwrap-panic (contract-call? .mock-dia set-skew u10000))
    (unwrap-panic (contract-call? .mock-native set-failed false))
    (unwrap-panic (contract-call? .mock-native set-mid (lazer-mid)))
    (unwrap-panic (contract-call? .mock-lazer-oracle set-fee u0))
    (unwrap-panic (contract-call? .mock-router set-quality u10000))
    (unwrap-panic (contract-call? .mock-router set-fill u10000))
    true))
;; top the router up to `ustx` (a flat transfer per test drained the
;; deployer's 1e14 uSTX within ~1000 tests: a harness artefact, not a finding)
(define-private (fund-router (ustx uint))
  (let ((bal (stx-get-balance .mock-router)))
    (if (< bal ustx) (stx-transfer? (- ustx bal) tx-sender .mock-router) (ok true))))

;; Best effort back to idle (no vault cycle): finalize a ready vault, sell
;; out and finalize an elapsed one, recover one past the signer deadline.
(define-private (try-idle)
  (let ((c (clock)))
    (calm-world)
    (if (get ready-to-finish c)
      (is-ok (contract-call? .signer-manager-vault-stx-rewards finalize-swap-vault .fastpool-swap-vault))
      (if (get window-elapsed c)
        (begin
          (match (contract-call? .fastpool-swap-vault jing-reclaim) r true e true)
          (unwrap-panic (adm-cooldown u0))
          (unwrap-panic (adm-chunk u100000000))
          (unwrap-panic (fund-router u40000000000))
          (let ((bal (sbtc VAULT)))
            (and (> bal u0)
              (match (adm-dia bal bal u0 u0) r true e true)))
          (match (contract-call? .fastpool-swap-vault close-batch) r true e true)
          (and (get ready-to-finish (clock))
            (is-ok (contract-call? .signer-manager-vault-stx-rewards finalize-swap-vault .fastpool-swap-vault))))
        true))
    (and (is-some (contract-call? .signer-manager-vault-stx-rewards get-vault-cycle))
      (is-ok (contract-call? .signer-manager-vault-stx-rewards recover-swap-vault .fastpool-swap-vault)))
    (is-none (contract-call? .signer-manager-vault-stx-rewards get-vault-cycle))))

;; a fresh claimed cycle funded into the vault; returns the vault sats
(define-private (open-cycle (sats uint) (bips uint))
  (let ((c (var-get next-cycle)))
    (var-set next-cycle (+ c u1))
    (try! (adm-fees bips))
    (try! (contract-call? .mock-pox add-rewards c sats))
    (try! (contract-call? .signer-manager-vault-stx-rewards claim-rewards c))
    (contract-call? .signer-manager-vault-stx-rewards fund-swap-vault c .fastpool-swap-vault)))

;; --- P1: finish returns balance - min(balance, budget), fees exact -------------
(define-private (test-finish-reserve (sats-raw uint) (stx-raw uint) (budget-raw uint) (bips-raw uint))
  (if (not (try-idle)) (ok false)
    (let (
        (small (is-eq (mod sats-raw u3) u0))
        ;; small batches let the reserve keep everything (budget >= balance)
        (sats (if small (+ u10 (mod sats-raw u2000)) (+ u100000 (mod sats-raw u5000000))))
        (bips (if small u0 (mod bips-raw u10000)))
        (budget (mod budget-raw u10000001))
        (c (var-get next-cycle))
        (earned0 (contract-call? .signer-manager-vault-stx-rewards get-earned-fees))
      )
      (try! (adm-window u0))
      (try! (adm-cooldown u0))
      (try! (adm-chunk u100000000))
      (try! (adm-budget budget))
      (let ((vsats (try! (open-cycle sats bips))) (fee (/ (* sats bips) BPS)))
        (try! (check (is-eq vsats (- sats fee)) u1))
        (try! (check (is-eq (contract-call? .signer-manager-vault-stx-rewards get-earned-fees) (+ earned0 fee)) u2))
        (try! (fund-router u40000000000))
        (try! (contract-call? .fastpool-swap-vault router-swap 0x))
        (try! (check (get ready-to-finish (clock)) u3))
        (and (not small) (> (mod stx-raw u100000000) u0)
          (try! (stx-transfer? (mod stx-raw u100000000) tx-sender VAULT)))
        (let (
            (bal (stx-get-balance VAULT))
            (sx0 (stx-get-balance SIGNER))
            (unpaid0 (contract-call? .signer-manager-vault-stx-rewards get-unpaid-stx))
            (amount (try! (contract-call? .signer-manager-vault-stx-rewards finalize-swap-vault .fastpool-swap-vault)))
          )
          (print { rv-prop: "finish", rv-z: (if (> bal budget) "partial" "all-kept") })
          (try! (check (is-eq amount (- bal (min2 bal budget))) u4))
          (try! (check (is-eq (stx-get-balance VAULT) (min2 bal budget)) u5))
          (try! (check (is-eq (stx-get-balance SIGNER) (+ sx0 amount)) u6))
          (try! (check (is-eq (contract-call? .signer-manager-vault-stx-rewards get-unpaid-stx) (+ unpaid0 amount)) u7))
          (try! (check (is-eq (get stx-out (contract-call? .signer-manager-vault-stx-rewards get-settlement c)) amount) u8))
          (try! (check (not (get ready-to-finish (clock))) u9))
          (ok true))))))

;; --- P2: the permissionless router-swap never sells under the floor ------------
;; accepted <=> the vault can pay the fee within budget AND the router sold
;; more than the slack AND out >= floor-out(sold - 8, mid * (1 - slippage))
(define-private (test-router-floor (sats-raw uint) (q-raw uint) (f-raw uint) (slip-raw uint) (fee-raw uint) (budget-raw uint))
  (if (not (try-idle)) (ok false)
    (let (
        (sats (+ u100000 (mod sats-raw u5000000)))
        (q (+ u9000 (mod q-raw u1600)))
        (fill (if (is-eq (mod f-raw u4) u0) u10000 (mod f-raw u10001)))
        (slip (mod slip-raw u1001))
        (fee (unwrap-panic (element-at? (list u0 u0 u1000 u50000) (mod fee-raw u4))))
        (budget (mod budget-raw u100001))
      )
      (try! (adm-window u0))
      (try! (adm-cooldown u0))
      (try! (adm-chunk u100000000))
      (try! (adm-slip slip))
      (try! (adm-budget budget))
      (let ((vsats (try! (open-cycle sats u0))))
        (try! (stx-transfer? (+ u1 (* u2 fee)) tx-sender VAULT))
        (try! (fund-router u40000000000))
        (try! (contract-call? .mock-router set-quality q))
        (try! (contract-call? .mock-router set-fill fill))
        (try! (contract-call? .mock-lazer-oracle set-fee fee))
        (let (
            (m (lazer-mid))
            (take (/ (* vsats fill) BPS))
            (out (/ (* (/ (* take m) FO_DIV) q) BPS))
            (accept (and (<= fee budget) (> take u8) (> out u0)
                         (>= out (fo (- take u8) (under m slip)))))
            (vx0 (stx-get-balance VAULT))
            (os0 (stx-get-balance .mock-lazer-oracle))
            (res (contract-call? .fastpool-swap-vault router-swap 0x))
          )
          (try! (contract-call? .mock-lazer-oracle set-fee u0))
          (print { rv-prop: "router-floor", rv-z: (if accept "accept" (if (> fee budget) "reject-fee" "reject-floor")) })
          (try! (check (is-eq (is-ok res) accept) u20))
          (if accept
            (begin
              (try! (check (is-eq (sbtc VAULT) (- vsats take)) u21))
              (try! (check (is-eq (+ (stx-get-balance VAULT) fee) (+ vx0 out)) u22))
              (try! (check (is-eq (stx-get-balance .mock-lazer-oracle) (+ os0 fee)) u23))
              (ok true))
            (begin
              (try! (check (is-eq (sbtc VAULT) vsats) u24))
              (try! (check (is-eq (stx-get-balance VAULT) vx0) u25))
              (ok true))))))))

;; --- P3: the split entry takes the router's min-out from the oracle -----------
(define-private (test-split-floor (sats-raw uint) (q-raw uint) (f-raw uint) (slip-raw uint) (pick uint))
  (if (not (try-idle)) (ok false)
    (let (
        (sats (+ u100000 (mod sats-raw u900000)))
        (q (+ u9000 (mod q-raw u1600)))
        (fill (if (is-eq (mod f-raw u2) u0) u10000 (mod f-raw u10001)))
        (slip (mod slip-raw u1001))
        (p (mod pick u4))
      )
      (try! (adm-window u0))
      (try! (adm-cooldown u0))
      (try! (adm-chunk u100000000))
      (try! (adm-slip slip))
      (let ((vsats (try! (open-cycle sats u0))))
        (try! (fund-router u40000000000))
        (try! (contract-call? .mock-router set-quality q))
        (try! (contract-call? .mock-router set-fill fill))
        (let (
            (m (lazer-mid))
            (limit (under m slip))
            (vlimit (under m u60))
            (velar (if (is-eq p u3) vsats u0))
            (min-out (+ (fo (- vsats velar) limit) (fo velar vlimit)))
            (take (/ (* vsats fill) BPS))
            (out (/ (* (/ (* take m) FO_DIV) q) BPS))
            ;; the mock router: no sale (unsold all) is only allowed at min-out 0
            (accept (if (and (> take u0) (> out u0)) (>= out min-out) (is-eq min-out u0)))
            (vx0 (stx-get-balance VAULT))
            (res (adm-split vsats (if (is-eq p u0) vsats u0) (if (is-eq p u1) vsats u0)
                   (if (is-eq p u2) vsats u0) velar))
          )
          (print { rv-prop: "split-floor", rv-z: (if accept "accept" "reject") })
          (try! (check (is-eq (is-ok res) accept) u30))
          (and accept
            (try! (check (>= (+ (- (stx-get-balance VAULT) vx0) u1) (fo vsats (min2 limit vlimit))) u31)))
          (ok true))))))

;; --- P4: the emergency DIA / native split never sells under its floor ---------
(define-private (test-dia-floor (sats-raw uint) (q-raw uint) (f-raw uint) (noslip-raw uint) (skew-raw uint) (fail-raw uint))
  (if (not (try-idle)) (ok false)
    (let (
        (sats (+ u100000 (mod sats-raw u900000)))
        (q (+ u4000 (mod q-raw u6600)))
        (fill (if (is-eq (mod f-raw u2) u0) u10000 (mod f-raw u10001)))
        (noslip (mod noslip-raw u5001))
        (skew (+ u5000 (mod skew-raw u10001)))
        (dia-fail (is-eq (mod fail-raw u3) u0))
        (native-mid (/ (* (lazer-mid) (+ u5000 (mod fail-raw u10001))) BPS))
      )
      (try! (adm-window u0))
      (try! (adm-cooldown u0))
      (try! (adm-chunk u100000000))
      (try! (adm-noslip noslip))
      (let ((vsats (try! (open-cycle sats u0))))
        (try! (fund-router u40000000000))
        (try! (contract-call? .mock-router set-quality q))
        (try! (contract-call? .mock-router set-fill fill))
        (try! (contract-call? .mock-dia set-skew skew))
        (try! (contract-call? .mock-dia set-failed dia-fail))
        (try! (contract-call? .mock-native set-mid native-mid))
        (let (
            (m (lazer-mid))
            ;; mock DIA: BTC/USD = mid * skew / 1e4, STX/USD = 1e8
            (limit (if dia-fail (/ native-mid u2) (under (/ (* m skew) BPS) noslip)))
            (min-out (fo vsats limit))
            (take (/ (* vsats fill) BPS))
            (out (/ (* (/ (* take m) FO_DIV) q) BPS))
            (accept (and (> limit u0) (if (and (> take u0) (> out u0)) (>= out min-out) (is-eq min-out u0))))
            (vx0 (stx-get-balance VAULT))
            (res (adm-dia vsats vsats u0 u0))
          )
          (try! (contract-call? .mock-dia set-failed false))
          (print { rv-prop: "dia-floor", rv-z: (if accept (if dia-fail "accept-native" "accept-dia") (if dia-fail "reject-native" "reject-dia")) })
          (try! (check (is-eq (is-ok res) accept) u40))
          (and accept
            (try! (check (>= (- (stx-get-balance VAULT) vx0) (fo (- vsats (sbtc VAULT)) limit)) u41)))
          (ok true))))))

;; --- P5: patience: nothing sells while the window is open; the peg rests -------
(define-private (test-patience (sats-raw uint) (w-raw uint))
  (if (not (try-idle)) (ok false)
    (let ((sats (+ u100000 (mod sats-raw u900000))) (w (+ u1 (mod w-raw u10))))
      (try! (adm-window w))
      (try! (adm-cooldown u0))
      (let ((vsats (try! (open-cycle sats u0))))
        (try! (fund-router u40000000000))
        (try! (check (is-eq (contract-call? .fastpool-swap-vault router-swap 0x) (err u16031)) u50))
        (try! (check (is-eq (adm-take vsats) (err u16031)) u51))
        (try! (check (is-eq (adm-split vsats u0 vsats u0 u0) (err u16031)) u52))
        (try! (check (is-eq (adm-dia vsats vsats u0 u0) (err u16031)) u53))
        (try! (check (is-eq (contract-call? .fastpool-swap-vault jing-reclaim) (err u16031)) u54))
        ;; a second funding while busy is refused by the signer
        (try! (contract-call? .mock-pox add-rewards (var-get next-cycle) u5000))
        (try! (contract-call? .signer-manager-vault-stx-rewards claim-rewards (var-get next-cycle)))
        (try! (check (is-eq (contract-call? .signer-manager-vault-stx-rewards fund-swap-vault (var-get next-cycle) .fastpool-swap-vault) (err u1050)) u55))
        (var-set next-cycle (+ (var-get next-cycle) u1))
        ;; resting is the one thing the open window allows
        (try! (contract-call? .fastpool-swap-vault jing-place 0x))
        (print { rv-prop: "patience", rv-z: "checked" })
        (try! (check (is-eq (sbtc VAULT) u0) u56))
        (try! (check (is-eq (contract-call? .v6-market get-token-x-order VAULT)
          { limit: (under (lazer-mid) (get leeway-bps (contract-call? .fastpool-swap-vault get-config))), spread-bps: (some u0) }) u57))
        (ok true)))))

;; --- P6: fees: withdraw only what accrued; sweeps never reach obligations ------
(define-private (test-fee-withdraw (raw uint))
  (let (
      (earned (contract-call? .signer-manager-vault-stx-rewards get-earned-fees))
      (amount (+ u1 (mod raw (+ earned u2))))
      (sb0 (sbtc SIGNER))
      (res (adm-withdraw amount))
    )
    (print { rv-prop: "fee-withdraw", rv-z: (if (<= amount earned) "ok" "over") })
    (if (<= amount earned)
      (begin
        (try! (check (is-ok res) u60))
        (try! (check (is-eq (contract-call? .signer-manager-vault-stx-rewards get-earned-fees) (- earned amount)) u61))
        (try! (check (is-eq (sbtc SIGNER) (- sb0 amount)) u62)))
      (try! (check (is-eq res (err u1005)) u63)))
    (try! (check (>= (sbtc SIGNER) (+ (contract-call? .signer-manager-vault-stx-rewards get-earned-fees)
                                      (contract-call? .signer-manager-vault-stx-rewards get-unswapped-sats))) u64))
    (ok true)))

;; --- P7: distribution: pro-rata, never past stx-out, idempotent ---------------
(define-constant ALICE 'ST1SJ3DTE5DN7X54YDH5D64R3BCB6A2AG2ZQ8YPD5)
(define-constant BOB 'ST2JHG361ZXG51QTKY2NQCVBPPRRE2KZB1HR05NNC)
(define-private (test-distribute (sats-raw uint) (a-raw uint) (b-raw uint) (bips-raw uint))
  (if (not (try-idle)) (ok false)
    (let (
        (c (var-get next-cycle))
        (sa (+ u1000000 (mod a-raw u400000000000)))
        (sb (+ u1000000 (mod b-raw u400000000000)))
        (sats (+ u100000 (mod sats-raw u5000000)))
      )
      (try! (contract-call? .mock-pox stake .signer-manager-vault-stx-rewards ALICE c u1 sa))
      (try! (contract-call? .mock-pox stake .signer-manager-vault-stx-rewards BOB c u1 sb))
      (try! (adm-window u0))
      (try! (adm-cooldown u0))
      (try! (adm-chunk u100000000))
      (try! (adm-budget u0))
      (try! (open-cycle sats (mod bips-raw u2000)))
      (try! (fund-router u40000000000))
      (try! (contract-call? .fastpool-swap-vault router-swap 0x))
      (let (
          (amount (try! (contract-call? .signer-manager-vault-stx-rewards finalize-swap-vault .fastpool-swap-vault)))
          (xa (stx-get-balance ALICE)) (xb (stx-get-balance BOB))
          (unpaid0 (contract-call? .signer-manager-vault-stx-rewards get-unpaid-stx))
          (r (try! (contract-call? .signer-manager-vault-stx-rewards distribute-rewards-many (list ALICE BOB ALICE) c)))
          (da (/ (* amount sa) (+ sa sb))) (db (/ (* amount sb) (+ sa sb)))
        )
        (print { rv-prop: "distribute", rv-z: (if (> amount u0) "paid" "zero") })
        (try! (check (is-eq (- (stx-get-balance ALICE) xa) da) u70))
        (try! (check (is-eq (- (stx-get-balance BOB) xb) db) u71))
        (try! (check (<= (+ da db) amount) u72))
        (try! (check (is-eq (get total-stx r) (+ da db)) u73))
        (try! (check (is-eq (contract-call? .signer-manager-vault-stx-rewards get-unpaid-stx) (- unpaid0 (+ da db))) u74))
        ;; a repeat pays nothing
        (try! (check (is-eq (contract-call? .signer-manager-vault-stx-rewards distribute-rewards ALICE c) (err u1013)) u75))
        (try! (check (>= (stx-get-balance SIGNER) (contract-call? .signer-manager-vault-stx-rewards get-unpaid-stx)) u76))
        (ok true)))))
