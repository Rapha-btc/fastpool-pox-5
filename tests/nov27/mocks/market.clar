;; Minimal ledger: supports resting dust and cancellation, and configurable min-x.
(define-data-var min-x uint u1000)
(define-map deposits principal uint)
(define-public (set-min-x (n uint)) (ok (var-set min-x n)))
(define-read-only (get-min-deposits) {min-token-x: (var-get min-x), min-token-y: u1000})
(define-read-only (get-current-cycle) u1)
(define-read-only (get-token-x-deposit (cycle uint) (who principal)) (default-to u0 (map-get? deposits who)))
(define-read-only (get-token-x-parked (who principal)) u0)
(define-read-only (get-token-x-pending-deposit (who principal)) (if false (some {amount: u0}) none))
(define-read-only (get-taker-rebate-bps-for (update (buff 8192))) u20)
(define-public (refresh-mid (update (buff 8192))) (if true (ok u10000000000) (err u999)))
(define-public (deposit-token-x (n uint) (limit uint) (spread (optional uint)) (token principal) (asset (string-ascii 128)))
 (begin (try! (contract-call? .token transfer n tx-sender current-contract none)) (map-set deposits tx-sender n) (ok n)))
(define-public (cancel-token-x-deposit (token principal) (asset (string-ascii 128)))
 (let ((who tx-sender) (n (default-to u0 (map-get? deposits tx-sender))))
 (map-delete deposits who)
 (if (> n u0) (try! (as-contract? ((with-ft .token "sbtc-token" n)) (try! (contract-call? .token transfer n current-contract who none)))) true)
 (ok n)))
(define-public (set-token-x-limit (limit uint) (spread (optional uint))) (if true (ok u0) (err u999)))
(define-public (swap (n uint) (limit uint) (update (buff 8192)) (x principal) (xn (string-ascii 128)) (y principal) (yn (string-ascii 128)) (sell bool))
 (let ((who tx-sender))
 (try! (contract-call? .token transfer n who current-contract none))
 (try! (as-contract? ((with-stx n)) (try! (stx-transfer? n current-contract who))))
 (ok {token-y-received: n, token-x-received: u0})))
